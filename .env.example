# Copy to .env.local (never commit it). Set the same keys in Vercel.
# Never prefix any of these with NEXT_PUBLIC_.

# --- Required ---
# @BotFather bot token. Also used to verify Telegram initData.
TELEGRAM_BOT_TOKEN=
# Bot username without @, and the Mini App short name from /newapp (used for referral links).
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=studio
# 20+ random characters [A-Za-z0-9_-]; checked on every Stars webhook call.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# Neon PostgreSQL connection string.
DATABASE_URL=

# Cloudflare R2 (S3 API) credentials with object read/write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=visionai-media

# Runway API key (api.dev.runwayml.com).
RUNWAY_API_KEY=

# --- Optional ---
# 'viggle' routes "Me in Video" (act mode) to Viggle; anything else uses Runway.
VIDEO_PROVIDER=runway
VIGGLE_API_KEY=
# Enables multi-person video replacement (LovelyRouter). Without it the feature returns 503.
LOVELY_API_KEY=
# Credits charged per second of multi-person replacement (1-1000, default 12).
SWAP_CREDITS_PER_SECOND=12
# Per-user rate limits (1-1000). Over the limit returns 429 with Retry-After.
# Free swap video analysis: each one is a full download + a paid provider call.
SWAP_ANALYSES_PER_HOUR=10
SWAP_ANALYSES_PER_DAY=30
# Generations (already paid in credits; stops runaway clients and spam).
GENERATIONS_PER_HOUR=20
GENERATIONS_PER_DAY=100
# Signed upload URLs (each allows up to 50MB into R2; a swap needs up to 5).
UPLOADS_PER_HOUR=60
UPLOADS_PER_DAY=300
# Free credits for new users (0-3). Keep 0 in production unless you accept the cost.
SIGNUP_CREDITS=0
